{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*", "../compartido/**/*"],
  "exclude": ["dist", "worker"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "resolveJsonModule": true,
    "paths": { "@compartido/*": ["../compartido/*"] }
  }
}
